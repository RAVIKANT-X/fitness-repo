{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "version": 2,

  "comment": "Vercel deployment configuration for the Node.js/Express backend.",

  "rootDirectory": "backend",

  "functions": {
    "api/index.ts": {
      "runtime": "@vercel/node@4",
      "maxDuration": 10
    }
  },

  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
