# ──────────────────────────────────────────────
# AI Fitness Coach — Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# PostgreSQL
POSTGRES_DB=fitness_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_before_use
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full connection URL used by SQLAlchemy and Alembic
# Format: postgresql://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql://postgres:change_me_before_use@postgres:5432/fitness_db
